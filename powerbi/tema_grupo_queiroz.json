{
  "name": "Grupo Queiroz",
  "dataColors": ["#333333", "#E60D25", "#8A8886", "#B00A1C", "#C8C6C4", "#000000", "#F29AA4", "#605E5C"],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#E60D25",
  "maximum": "#E60D25",
  "center": "#F29AA4",
  "minimum": "#FFFFFF",
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F2F1" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#E1DFDD" } }, "radius": 4 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }]
      }
    }
  }
}
