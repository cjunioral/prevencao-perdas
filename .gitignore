# Credenciais
.env

# Dados: planilha e extrações da Consinco NÃO vão para o repositório
entrada/*
!entrada/.gitkeep
*.xlsm
*.xlsx
*.csv
# dados fictícios são recriados por tests/gerar_dados_ficticios.py
tests/dados_ficticios/

# Logs
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Power BI: o .pbix tem dados reais e é entregue à parte (não vai para o Git)
powerbi/*.pbix

# Evidências da conferência com a Consinco (dados reais de venda): ficam só na máquina
docs/conferencia/
