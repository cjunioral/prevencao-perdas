# Copie para .env e preencha. O .env NUNCA vai para o Git (está no .gitignore).

# ---------- PostgreSQL analítico (local) ----------
PG_HOST=localhost
PG_PORT=5432
PG_DB=prevencao_perdas
PG_USER=postgres
PG_PASSWORD=

# ---------- Consinco (Oracle) — use um usuário SOMENTE LEITURA ----------
# oracle = produção | mock = dados fictícios de tests/dados_ficticios (para testes)
CONSINCO_MODO=oracle
ORACLE_USER=
ORACLE_PASSWORD=
# host:porta/servico  (ex.: 10.0.0.10:1521/CONSINCO)
ORACLE_DSN=
# Dono das tabelas da Consinco. As consultas não levam o prefixo (CONSINCO.TABELA);
# com o usuário de leitura diferente do dono, a sessão precisa apontar para o schema.
ORACLE_SCHEMA=CONSINCO
# Tempo máximo por chamada ao Oracle (ms). Evita consulta presa na produção.
ORACLE_TIMEOUT_MS=600000

# ---------- Escopo do negócio ----------
PERIODO_INICIO=2026-09-01
# Vazio = até ontem. Preencha para fechar o período (ex.: 2026-10-31).
PERIODO_FIM=
# Rótulo:SEQCATEGORIA na Consinco. CONFIRMADO em MAP_CATEGORIA (10/11/2026):
# divisão 1, nível 1: ACOUGUE = 11, HORTIFRUTI = 24.
CATEGORIAS_ESCOPO=AÇOUGUE:11,HORTIFRUTI:24
# Nível hierárquico em que Açougue e Hortifruti estão em MAP_CATEGORIA
NIVEL_CATEGORIA=1
# CGOs de avaria: tipo 'AS' no ABC de movimentação (549,552,562,563) + 403 (enunciado)
CGOS_AVARIA=403,549,552,562,563

# ---------- Carga incremental ----------
# Quantos dias para trás a carga diária reprocessa (captura lançamentos retroativos)
JANELA_RETROATIVA_DIAS=40
# Tamanho de cada bloco de extração no Oracle (consultas menores e mais leves)
BLOCO_EXTRACAO_DIAS=7
# Em horário comercial, extrações maiores que o limite (dias) são bloqueadas
HORARIO_COMERCIAL=07:30-21:00
LIMITE_DIAS_HORARIO_COMERCIAL=3

# ---------- Planilha ----------
PASTA_ENTRADA=entrada
PADRAO_PLANILHA=*.xls[xm]
# Mesma loja+produto+data com valores diferentes: rejeitar | somar
DUPLICIDADE_CONFLITANTE=rejeitar

PASTA_LOGS=logs
